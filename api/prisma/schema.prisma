// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"

  // Optional Prisma Client Generator configuration
  runtime                = "nodejs" // <-- Important part 2
  moduleFormat           = "cjs"
  generatedFileExtension = "ts" // <-- Important part 3
}

datasource db {
  provider = "postgresql"
}

model Experiment {
  id                Int                        @id @unique @default(autoincrement())
  createdAt         DateTime?                  @default(now())
  endAt             DateTime?                  @default(now())
  experimentDetails ExperimentDetails[]
  dataSetDetails    ExperimentDataSetDetails[]
  experimentSteps   ExperimentStep[]
  modelSchemas      ModelSchema[]
  modelLayers       ModelLayer[]

  @@map("experiment")
}

model ExperimentDetails {
  id            Int        @id @unique @default(autoincrement())
  createdAt     DateTime?  @default(now())
  experiment_id Int
  layers        String
  activation    String
  optimizer     String
  regularizer   String     @default("")
  loss          String
  epochs        Int
  batch_size    Int
  units_range   String
  Expirement    Experiment @relation(fields: [experiment_id], references: [id])

  @@map("experiment_details")
}

model ExperimentDataSetDetails {
  id                  Int        @id @unique @default(autoincrement())
  createdAt           DateTime?  @default(now())
  experiment_id       Int
  duration            Float
  labels              String
  argumentation_types String
  af_type             String
  Expirement          Experiment @relation(fields: [experiment_id], references: [id])

  @@map("experiment_data_set_details")
}

model ExperimentStep {
  id            Int       @id @unique @default(autoincrement())
  createdAt     DateTime? @default(now())
  experiment_id Int

  step                     Int
  fingerprint              String
  record_accuracy          Float  @default(0)
  validation_accuracy      Float  @default(0)
  accuracy_delta           Float  @default(0)
  epochs                   Int    @default(0)
  training_history_plot_id Int

  Expirement            Experiment     @relation(fields: [experiment_id], references: [id])
  modelSchemas          ModelSchema[]
  modelLayers           ModelLayer[]
  training_history_plot Image          @relation(fields: [training_history_plot_id], references: [id])
  recordResults         RecordResult[]

  @@map("experiment_step")
}

model ModelSchema {
  id                 Int       @id @unique @default(autoincrement())
  createdAt          DateTime? @default(now())
  experiment_id      Int
  experiment_step_id Int
  optimizer          String
  loss               String
  plot_id            Int

  Expirement     Experiment     @relation(fields: [experiment_id], references: [id])
  ExperimentStep ExperimentStep @relation(fields: [experiment_step_id], references: [id])
  modelLayers    ModelLayer[]
  plot           Image          @relation(fields: [plot_id], references: [id])

  @@map("model_schema")
}

model ModelLayer {
  id                 Int       @id @unique @default(autoincrement())
  createdAt          DateTime? @default(now())
  experiment_id      Int
  experiment_step_id Int
  model_schema_id    Int

  type        String
  units       Int
  activation  String
  regularizer String

  Expirement     Experiment     @relation(fields: [experiment_id], references: [id])
  ExperimentStep ExperimentStep @relation(fields: [experiment_step_id], references: [id])
  ModelSchema    ModelSchema    @relation(fields: [model_schema_id], references: [id])

  @@map("model_layer")
}

model Image {
  id              Int              @id @unique @default(autoincrement())
  base64          String
  modelSchemas    ModelSchema[]
  experimentSteps ExperimentStep[]
  recordResults   RecordResult[]

  @@map("image")
}

model RecordResult {
  id                 Int   @id @unique @default(autoincrement())
  experiment_step_id Int
  image_id           Int
  accuracy           Float

  ExperimentStep ExperimentStep @relation(fields: [experiment_step_id], references: [id])
  image          Image          @relation(fields: [image_id], references: [id])

  @@map("record_result")
}
